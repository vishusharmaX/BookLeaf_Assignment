# ==========================================
# BookLeaf Author Support Portal - Environment Config
# ==========================================

# PostgreSQL with Supabase Pooler:
DATABASE_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-xxx.pooler.supabase.com:5432/postgres"

# Session & JWT Secret (minimum 32 characters)
AUTH_SECRET="bookleaf-secure-production-auth-secret-key-32chars"

# AI Provider Configuration
# Supported providers: "openai" | "gemini" | "anthropic" | "rule_engine"
# If AI_API_KEY is not provided, system seamlessly uses the built-in BookLeaf Knowledge Engine
AI_PROVIDER="rule_engine"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Base Application URL
APP_URL="http://localhost:3000"
PORT=3000
